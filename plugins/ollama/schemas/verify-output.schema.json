{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["passed", "summary", "criteriaResults"],
  "properties": {
    "passed": {
      "type": "boolean",
      "description": "True if every successCriterion was met by the diff."
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "description": "One-paragraph human-readable verdict."
    },
    "criteriaResults": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion", "met", "evidence"],
        "properties": {
          "criterion": {
            "type": "string",
            "minLength": 1,
            "description": "The successCriteria text this result evaluates."
          },
          "met": {
            "type": "boolean"
          },
          "evidence": {
            "type": "string",
            "description": "What the verifier observed (file:line refs, quoted lines, or 'no change' for unmet criteria)."
          }
        }
      }
    },
    "remediation": {
      "type": "string",
      "description": "If not passed: what the implementer should do differently next iteration."
    }
  }
}
