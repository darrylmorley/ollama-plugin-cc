{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["task", "rationale", "confidence", "steps"],
  "properties": {
    "task": {
      "type": "string",
      "minLength": 1,
      "description": "The original task description from the user."
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "description": "Why this plan, what was inspected to ground it."
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Planner's self-assessed confidence that this plan will succeed."
    },
    "scope": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Files or globs the plan will touch."
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "successCriteria"],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "files": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Files or file:line ranges this step touches."
          },
          "successCriteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "dependencies": {
            "type": "array",
            "items": { "type": "integer", "minimum": 1 },
            "description": "Step IDs that must complete before this step runs."
          }
        }
      }
    }
  }
}
